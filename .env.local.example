# ============================================================
# 미스터시래기 POS — 환경변수 예시
# 이 파일을 복사해 .env.local 로 만들고 값을 채우세요.
#   cp .env.local.example .env.local
# 매장의 기존 Supabase 프로젝트 값을 그대로 사용합니다.
# ============================================================

# Supabase Project URL (예: https://abcdxyz.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# anon public 키 (브라우저에 노출되어도 되는 공개 키)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
